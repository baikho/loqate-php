{
    "name": "baikho/loqate-php",
    "description": "A PHP Wrapper for the Loqate API",
    "homepage": "https://github.com/baikho/loqate-php",
    "type": "library",
    "keywords": [ "php", "loqate", "api" ],
    "license": "MIT",
    "authors": [
        {
            "name": "Sang Lostrie",
            "email": "sang.lostrie@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^6.5 || ^7.2 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^2.18 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "Baikho\\Loqate\\": "src"
        }
    }
}
